# ─────────────────────────────────────────────────────────────
# Indic Voice AI — Environment Variables Reference
# Copy this file to .env and fill in the values for your env.
# NEVER commit a populated .env file to version control.
# ─────────────────────────────────────────────────────────────

# ── Frontend (Vite) ──────────────────────────────────────────
# Base URL for the production API (used by VoiceCloner.jsx etc.)
# Phase 6+: point this at your CF Workers URL instead of FastAPI directly.
# Leave blank when running behind a Cloudflare Pages proxy rule.
VITE_API_URL=

# Cloudflare Workers gateway endpoint (Phase 6)
# Set to your Worker URL after: cd workers && npm run deploy
VITE_WORKERS_URL=

# API key for the Workers gateway (Phase 7 — leave blank until Phase 7)
# VITE_WORKER_API_KEY=

# Override the backend target used by the Vite dev-server proxy.
# Defaults to http://localhost:8000 when not set.
VITE_DEV_BACKEND=http://localhost:8000

# ── Backend (FastAPI / Python worker) ────────────────────────
# Hugging Face model hub token for downloading gated models.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where to store model weights cache (default: ~/.cache/huggingface)
# HF_HOME=/mnt/models

# Port the FastAPI server binds to (default: 8000)
# PORT=8000

# ── Cloudflare Workers (Phase 6) ─────────────────────────────
# Set BACKEND_URL in the CF dashboard or via:
#   wrangler secret put BACKEND_URL
# Do NOT put real URLs or secrets in this file.
# BACKEND_URL=https://your-backend.railway.app

# Worker version (set in workers/wrangler.toml [vars], not here)
# WORKER_VERSION=6.0.0

# ── Cloudflare Pages / Workers — dashboard-only secrets ───────
# Set these in the Cloudflare dashboard, NOT in this file.
# CF_ACCOUNT_ID=<your-cloudflare-account-id>
# CF_API_TOKEN=<your-cloudflare-api-token>

# ── R2 + KV (Phase 6) ────────────────────────────────────────
# Configured in workers/wrangler.toml, not as .env vars.
# Setup commands:
#   wrangler r2 bucket create indic-voice-audio
#   wrangler kv namespace create indic-voice-jobs
# See docs/CLOUDFLARE_WORKERS.md § 7 for full setup instructions.
