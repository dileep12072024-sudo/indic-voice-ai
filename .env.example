# ─────────────────────────────────────────────────────────────
# Indic Voice AI — Environment Variables Reference
# Copy this file to .env and fill in the values for your env.
# NEVER commit a populated .env file to version control.
# ─────────────────────────────────────────────────────────────

# ── Frontend (Vite) ──────────────────────────────────────────
# Base URL for the production API (used by VoiceCloner.jsx etc.)
# Leave blank when running behind a Cloudflare Pages proxy rule.
VITE_API_URL=

# Override the backend target used by the Vite dev-server proxy.
# Defaults to http://localhost:8000 when not set.
VITE_DEV_BACKEND=http://localhost:8000

# ── Backend (FastAPI / Python worker) ────────────────────────
# Hugging Face model hub token for downloading gated models.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where to store model weights cache (default: ~/.cache/huggingface)
# HF_HOME=/mnt/models

# Port the FastAPI server binds to (default: 8000)
# PORT=8000

# ── Cloudflare Pages / Workers ────────────────────────────────
# Set these in the Cloudflare dashboard, not in this file.
# CF_ACCOUNT_ID=<your-cloudflare-account-id>
# CF_API_TOKEN=<your-cloudflare-api-token>
