# IndicVoice AI — Frontend environment variables
# Copy this file to .env (or .env.local) and fill in values.
# NEVER commit a populated .env file to version control.

# ── Local development (required for local use) ────────────────────────────
# Points the Vite dev server at the local FastAPI backend.
# Without this, the Generate button cannot reach port 8000.
VITE_API_BASE=http://localhost:8000

# Override the backend proxy target for the Vite dev server.
# Defaults to http://localhost:8000 when not set.
VITE_DEV_BACKEND=http://localhost:8000

# ── Production / Cloudflare Workers ──────────────────────────────────────
# Set these for production builds; leave empty for local dev.
VITE_WORKERS_URL=
VITE_WORKER_API_KEY=
